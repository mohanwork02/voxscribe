# syntax=docker/dockerfile:1.7

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# System deps (needed for pyaudio wheels/build)
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential portaudio19-dev \
  && rm -rf /var/lib/apt/lists/*

# Install runtime dependencies first (better layer caching)
COPY requirements.docker.txt ./
RUN pip install --no-cache-dir -r requirements.docker.txt

# Use gosu to drop privileges after fixing volume permissions.
RUN apt-get update \
  && apt-get install -y --no-install-recommends gosu \
  && rm -rf /var/lib/apt/lists/*

# Copy application code
COPY interview_langgraph/ ./interview_langgraph/
COPY login/backend/ ./login/backend/

# Runtime writable directory for tenant artifacts (mount a volume here in production)
RUN mkdir -p ./interview_langgraph/artifacts && useradd -m app

# Entry point fixes volume ownership then drops privileges.
COPY --chmod=755 docker/entrypoint-api.sh /usr/local/bin/voxscribe-entrypoint

USER root
EXPOSE 8000

WORKDIR /app/login/backend
ENTRYPOINT ["voxscribe-entrypoint"]
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
